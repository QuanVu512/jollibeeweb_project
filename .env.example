# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO RENDER / PRODUCTION
# ==========================================

# Môi trường chạy (development | production)
NODE_ENV=production

# Cổng port (Render tự động cung cấp biến PORT, mặc định 10000)
PORT=10000

# Chuỗi kết nối MongoDB Atlas
# LƯU Ý: Cần thêm IP 0.0.0.0/0 vào Network Access trên MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/jollibee?retryWrites=true&w=majority

# Chuỗi bí mật JWT dùng để ký và xác thực token (tối thiểu 32 ký tự)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Thời gian hết hạn của token
JWT_EXPIRES_IN=8h

# Tên cookie và thời gian sống cookie (milliseconds: 8h = 28800000ms)
COOKIE_NAME=jollibee_admin_token
COOKIE_MAX_AGE_MS=28800000

# ==========================================
# TÙY CHỌN: TẠO TÀI KHOẢN ADMIN BAN ĐẦU (NẾU CẦN SEED)
# ==========================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Admin@123456
# ADMIN_DISPLAY_NAME=Quản trị viên
# ADMIN_FORCE_RESET=false
