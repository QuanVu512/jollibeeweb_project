# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND / RENDER
# ==========================================

NODE_ENV=production
PORT=10000

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/jollibee?retryWrites=true&w=majority

# Chuỗi bí mật JWT dùng để ký và xác thực token
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=8h

# Cấu hình Cookie
COOKIE_NAME=jollibee_admin_token
COOKIE_MAX_AGE_MS=28800000

# ==========================================
# TÙY CHỌN: TÀI KHOẢN ADMIN KHI SEED DỮ LIỆU
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_DISPLAY_NAME=Quản trị viên
ADMIN_FORCE_RESET=false
